# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Recomendado para novos projetos: chave publishable (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-aqui
# Compatibilidade com projetos antigos, se necessário:
# VITE_SUPABASE_ANON_KEY=sua-chave-anon-legada-aqui

# Demonstração local sem backend. Deixe false em uso real/homologação.
VITE_ENABLE_DEMO=false
